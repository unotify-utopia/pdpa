@echo off
chcp 65001 >nul
title [PDPA App] บันทึกและส่งโค้ดขึ้น GitHub (Finish Work)
cls
echo ========================================================
echo         กำลังตรวจสอบไฟล์ที่ถูกแก้ไขในโปรเจกต์...
echo ========================================================
git status -s
echo.
set /p commit_msg="พิมพ์รายละเอียดงานที่ทำเสร็จ (หรือกด Enter เพื่อใช้ข้อความมาตรฐาน): "
if "%commit_msg%"=="" set commit_msg=chore: sync work from computer
git add .
git commit -m "%commit_msg%"
echo.
echo ========================================================
echo          กำลังส่งโค้ดขึ้น GitHub (main branch)...
echo ========================================================
git push origin main
echo.
echo ========================================================
echo   บันทึกและส่งโค้ดขึ้น GitHub เรียบร้อยแล้วครับ! ปิดเครื่องได้เลย :)
echo ========================================================
echo.
pause
