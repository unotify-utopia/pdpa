# --- PostgreSQL Database Connection ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here

# --- Server Settings ---
PORT=3001
JWT_SECRET=your_jwt_secret_key_here

# --- Email OTP: Resend API (Primary) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OTP_SENDER_EMAIL=no-reply@utopia.in.th

# --- SMTP Fallback (Gmail or other) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=pdpa.utopia@gmail.com
SMTP_PASS=

# --- Cloudflare R2 Database Backup ---
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=pdpa-portal-backup
BACKUP_ENCRYPTION_KEY=put_any_random_32_characters_here_for_security
